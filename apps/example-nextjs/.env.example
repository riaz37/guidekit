# Required for proxy mode (token + LLM routes)
GUIDEKIT_SECRET=your-signing-secret-min-32-chars-long
LLM_API_KEY=your-gemini-or-openai-key

# Voice is enabled by default in the example app. Set to 0 for text-only mode.
# NEXT_PUBLIC_GUIDEKIT_VOICE=0

# Optional: server-side STT/TTS when using Deepgram/ElevenLabs instead of Web Speech
# STT_API_KEY=
# TTS_API_KEY=
